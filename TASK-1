import java.util.*;
import java.util.stream.*;

public class SalaryTransformation {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        IntStream.range(0, n)
                .map(i -> sc.nextInt())
                .map(salary -> salary + salary / 10)
                .forEach(salary -> System.out.print(salary + " "));

        sc.close();
    }
}


