import java.io.*;
import java.util.*;

public class Solution {

    // Z-like radius array from Manacher's algorithm
    // We use a transformed string:
    // # a # b # c #
    //
    // radius[i] = maximum number of characters we can expand
    // around transformed position i.
    private static int[] manacher(String s) {
        int n = s.length();

        int[] radius = new int[n];
        int center = 0;
        int right = 0;

        for (int i = 0; i < n; i++) {

            if (i < right) {
                radius[i] = Math.min(right - i,
                                     radius[2 * center - i]);
            }

            while (i - radius[i] - 1 >= 0 &&
                   i + radius[i] + 1 < n &&
                   s.charAt(i - radius[i] - 1)
                       == s.charAt(i + radius[i] + 1)) {
                radius[i]++;
            }

            if (i + radius[i] > right) {
                center = i;
                right = i + radius[i];
            }
        }

        return radius;
    }

    // Sparse table for range maximum queries
    static class SparseTable {
        int[][] table;
        int[] log;

        SparseTable(int[] arr) {
            int n = arr.length;

            log = new int[n + 1];

            for (int i = 2; i <= n; i++) {
                log[i] = log[i / 2] + 1;
            }

            int levels = log[n] + 1;
            table = new int[levels][n];

            System.arraycopy(arr, 0, table[0], 0, n);

            for (int k = 1; k < levels; k++) {
                int len = 1 << k;
                int half = len >> 1;

                for (int i = 0; i + len <= n; i++) {
                    table[k][i] = Math.max(
                        table[k - 1][i],
                        table[k - 1][i + half]
                    );
                }
            }
        }

        int query(int left, int right) {
            if (left > right) {
                return 0;
            }

            int len = right - left + 1;
            int k = log[len];

            return Math.max(
                table[k][left],
                table[k][right - (1 << k) + 1]
            );
        }
    }

    public static List<Integer> circularPalindromes(String s) {
        int n = s.length();

        /*
         * Create:
         *
         *   s + s
         *
         * and transform it to:
         *
         *   # a # b # c # ...
         *
         * This makes odd and even length palindromes
         * work with the same Manacher algorithm.
         */
        String doubled = s + s;

        int transformedLength = 2 * doubled.length() + 1;
        char[] transformed = new char[transformedLength];

        for (int i = 0; i < transformedLength; i++) {
            if ((i & 1) == 0) {
                transformed[i] = '#';
            } else {
                transformed[i] = doubled.charAt(i / 2);
            }
        }

        String t = new String(transformed);

        int[] radius = manacher(t);

        SparseTable rmq = new SparseTable(radius);

        List<Integer> answer = new ArrayList<>(n);

        /*
         * Rotation i corresponds to:
         *
         * doubled[i ... i+n-1]
         *
         * In the transformed string:
         *
         * left  = 2*i + 1
         * right = 2*(i+n-1) + 1
         */
        for (int i = 0; i < n; i++) {

            int left = 2 * i + 1;
            int right = 2 * (i + n - 1) + 1;

            int low = 1;
            int high = n;
            int best = 1;

            /*
             * Check whether a palindrome of length len
             * can fit completely inside this rotation.
             */
            while (low <= high) {
                int len = (low + high) >>> 1;

                /*
                 * Possible centers must lie between:
                 *
                 * left  + len - 1
                 * right - len + 1
                 *
                 * If any center has radius >= len,
                 * a palindrome of length len exists.
                 */
                int centerLeft = left + len - 1;
                int centerRight = right - len + 1;

                if (centerLeft <= centerRight &&
                    rmq.query(centerLeft, centerRight) >= len) {

                    best = len;
                    low = len + 1;
                } else {
                    high = len - 1;
                }
            }

            answer.add(best);
        }

        return answer;
    }

    public static void main(String[] args) throws Exception {
        BufferedReader br =
            new BufferedReader(new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine().trim());
        String s = br.readLine().trim();

        List<Integer> result = circularPalindromes(s);

        StringBuilder out = new StringBuilder();

        for (int value : result) {
            out.append(value).append('\n');
        }

        System.out.print(out);
    }
}
