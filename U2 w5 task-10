import java.util.*;

class Solution {

    public static ArrayList<Integer> search(String pattern, String text) {
        ArrayList<Integer> result = new ArrayList<>();

        int m = pattern.length();
        int n = text.length();

        // Build LPS array for the pattern
        int[] lps = new int[m];
        buildLPS(pattern, lps);

        int i = 0; // index for text
        int j = 0; // index for pattern

        while (i < n) {
            if (text.charAt(i) == pattern.charAt(j)) {
                i++;
                j++;
            }

            // Complete pattern found
            if (j == m) {
                result.add(i - j);

                // Continue searching for overlapping matches
                j = lps[j - 1];
            }
            // Mismatch after some matches
            else if (i < n && text.charAt(i) != pattern.charAt(j)) {
                if (j != 0) {
                    j = lps[j - 1];
                } else {
                    i++;
                }
            }
        }

        return result;
    }

    private static void buildLPS(String pattern, int[] lps) {
        int len = 0;
        int i = 1;

        while (i < pattern.length()) {
            if (pattern.charAt(i) == pattern.charAt(len)) {
                len++;
                lps[i] = len;
                i++;
            } else {
                if (len != 0) {
                    len = lps[len - 1];
                } else {
                    lps[i] = 0;
                    i++;
                }
            }
        }
    }
}
